#!/usr/bin/env sh
# Run the full build/test/lint{{COVERAGE_GAUNTLET_WORD}} gauntlet in a worktree and print ONE
# status line; everything else goes to <artifacts>/gauntlet.log. The
# orchestrator reads the line, never the log.
# Usage: sh .claude/scripts/gauntlet.sh <worktree> <artifacts-dir>
# Prints: gauntlet=pass cov=<lines%|-> sha=<short>
#     or: gauntlet=fail step=<name> sha=<short> log=<path>
#     or: gauntlet=fail step=<name> sha=<short> reason=timeout log=<path>
# Each step runs under `timeout` (seconds, second column) so a hung test
# fails the gauntlet instead of the session.
set -u
wt="${1:?worktree}"; art="${2:?artifacts dir}"
mkdir -p "$art"
log="$art/gauntlet.log"
: > "$log"
cd "$wt" || { echo "gauntlet=fail step=cd reason=no-worktree"; exit 1; }
sha=$(git rev-parse --short HEAD)
run() {
  step="$1"; limit="$2"; shift 2
  printf '### %s: %s\n' "$step" "$*" >> "$log"
  timeout "$limit" sh -c "$*" >> "$log" 2>&1
  rc=$?
  if [ "$rc" -ne 0 ]; then
    if [ "$rc" -eq 124 ]; then
      echo "gauntlet=fail step=$step sha=$sha reason=timeout log=$log"
    else
      echo "gauntlet=fail step=$step sha=$sha log=$log"
    fi
    exit 1
  fi
}
# One `run <step> <timeout-seconds> <command>` per line of the confirmed
# build/test/lint block (AGENTS.md `## Build / test / lint`), same order.
{{GAUNTLET_STEPS}}
# Line-coverage percentage from the log; `-` when no coverage step exists.
{{COVERAGE_EXTRACT}}
echo "gauntlet=pass cov=${cov:--} sha=$sha"
